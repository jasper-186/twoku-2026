# Copy this file to .env and fill in the values. It is read by
# docker-compose when the backend is started.
#
#   cp .env.example .env
#   docker compose up -d

# The public URL this deployment is reached at, with no trailing slash.
# The Roku app's env file must point BASE-URL at the same address.
DJANGO_BASE_URL=https://twoku-web.clstr.dev

# The Twitch application this backend authenticates against. Register one at
# https://dev.twitch.tv/console/apps and copy the credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Signing key for sessions and cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Leave these alone unless you are serving the backend under a name other
# than the one in DJANGO_BASE_URL.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Log lines carry OAuth tokens, device codes and signed playback URLs. Those
# are credentials, so they are redacted. Only turn this on while debugging.
LOG_SENSITIVE_DATA=false
