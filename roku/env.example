# Backend URL for this build.
#
# The Roku app reads this file from the root of the installed package
# (pkg:/env) and uses it for every backend call - /apptoken, /register,
# /unregister, /refresh, /getlivestream and /getvod - and to tell the user
# where to enter their login code.
#
# To point the app at your own backend, edit this file and rebuild:
#
#   cd roku
#   ./package.sh
#
# then sideload the resulting zip. The value is baked into the package, so
# changing it requires a rebuild.
#
# The trailing slash is optional.

BASE-URL=https://twoku-web.clstr.dev/
